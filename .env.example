# ===== 认证 =====
# 登录密码，随意修改，重启容器生效
APP_PASSWORD=change-me
# JWT 签名密钥，建议固定（可用 `openssl rand -hex 32` 生成），避免重启后旧 Refresh Token 失效
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== 时区与数据 =====
TZ=Asia/Shanghai
# SQLite 数据库与日志目录，挂载到宿主机
DATA_DIR=/data

# ===== 邮件提醒（SMTP，如 QQ 邮箱使用授权码）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@qq.com
SMTP_PASSWORD=
MAIL_TO=you@qq.com

# ===== 提醒策略 =====
REMINDER_LEAD_DAYS=30,7,1
REMINDER_CHECK_HOUR=9
